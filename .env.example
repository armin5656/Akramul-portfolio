# MongoDB Atlas connection string. Set the real value in Vercel Project Settings > Environment Variables.
# Do not commit a real .env file or expose this value in screenshots or chat.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster-host>/<database-name>?retryWrites=true&w=majority
# Use a unique, random value with 32 or more characters. Never expose it with NEXT_PUBLIC_.
ADMIN_SESSION_SECRET=<generate-a-long-random-secret>
# Required for distributed login rate limiting in Vercel serverless functions. Keep both values server-only.
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
# The public canonical site URL, used by metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://akramul-security-portfolio.vercel.app
